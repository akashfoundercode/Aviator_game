# SkyRush / Aviator Backend API & WebSocket Configuration
# Rename this file to .env or .env.local to activate real backend endpoints.

# Base REST API URL (leave empty to use built-in offline simulation mode)
# Example: https://api.yourdomain.com or http://localhost:8000
VITE_API_BASE_URL=

# Real-time WebSocket URL for flight ticks, live bets, countdowns, and multiplier sync
# Example: wss://api.yourdomain.com/ws/aviator or ws://localhost:8000/ws/aviator
VITE_WS_URL=

# API Timeout in Milliseconds (Default: 8000)
VITE_API_TIMEOUT=8000

# Fallback to local mock simulation if network or API error occurs (true/false)
VITE_USE_MOCK_FALLBACK=true
